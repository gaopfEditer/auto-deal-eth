{
  "agents": [
    {
      "id": "trader",
      "name": "Trader",
      // 指向包含该 Agent 配置文件(config.json/AGENTS.md)的具体目录
      "path": "openclaw-project/agents/trader", 
      "skills_path": "openclaw-project/agents/trader/skills"
    },
    {
      "id": "auditor",
      "path": "openclaw-project/agents/auditor",
      "skills_path": "openclaw-project/agents/auditor/skills"
    }
  ],
  // 核心：把项目根目录作为全局搜索路径，解决 shared 模块找不到的问题
  "global_paths": [
    "openclaw-project/"
  ]
}
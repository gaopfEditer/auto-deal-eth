# CryptoPulse / news_mornitor

# 数据目录（默认 news_mornitor/data）
# CRYPTO_PULSE_DATA_DIR=

# 抓取
CRYPTO_PULSE_FETCH_INTERVAL_SEC=300
CRYPTO_PULSE_REQUEST_DELAY_SEC=0.8
CRYPTO_PULSE_HTTP_TIMEOUT_SEC=25
# 1=使用内置 mock 数据（默认，无需打币安）；0=尝试真实 API
CRYPTO_PULSE_USE_MOCK=1
# CRYPTO_PULSE_BINANCE_SQUARE_URL=https://www.binance.com/bapi/...
# CRYPTO_PULSE_BINANCE_HEADERS_JSON={"cookie":"..."}
# CRYPTO_PULSE_BITGET_SQUARE_URL=https://www.bitget.com/...
# CRYPTO_PULSE_BITGET_HEADERS_JSON=
# CRYPTO_PULSE_OKX_SQUARE_URL=https://www.okx.com/...
# CRYPTO_PULSE_OKX_HEADERS_JSON=

# 宏观日历（金十风格）
CRYPTO_PULSE_MACRO_MIN_STAR=3
CRYPTO_PULSE_MACRO_AHEAD_HOURS=24
# CRYPTO_PULSE_JINSHI_URL=https://rili.jin10.com/index.php

# AI（可选）
CRYPTO_PULSE_AI_ENABLED=0
# CRYPTO_PULSE_LLM_API_KEY=
# CRYPTO_PULSE_LLM_BASE_URL=https://api.openai.com/v1
# CRYPTO_PULSE_LLM_MODEL=gpt-4o-mini

# Web
CRYPTO_PULSE_HOST=127.0.0.1
CRYPTO_PULSE_PORT=8770
CRYPTO_PULSE_API_CACHE_TTL_SEC=60
CRYPTO_PULSE_POSTS_MAX_KEEP=2000

# 代理（国内访问币安）
# HTTPS_PROXY=http://127.0.0.1:7890

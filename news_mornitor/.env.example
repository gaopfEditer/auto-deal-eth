# CryptoPulse / news_mornitor

# 数据目录（默认 news_mornitor/data）
# CRYPTO_PULSE_DATA_DIR=

# 抓取（默认 30 分钟）
CRYPTO_PULSE_FETCH_INTERVAL_SEC=1800
CRYPTO_PULSE_REQUEST_DELAY_SEC=0.8
CRYPTO_PULSE_HTTP_TIMEOUT_SEC=25
# 0=真实抓取（默认）；1=仅本地调试用演示数据（勿用于正式浏览）
CRYPTO_PULSE_USE_MOCK=0
# 启用源（逗号分隔）。Bitget/OKX/Bybit 公开广场 API 多数已 404，默认不含
# CRYPTO_PULSE_SOURCES=binance,bitget,reddit,tradingview,farcaster
# CRYPTO_PULSE_SOURCES=binance,bitget,okx,bybit,reddit,tradingview,farcaster

# 交易所广场 / Insights
# CRYPTO_PULSE_BINANCE_SQUARE_URL=
# CRYPTO_PULSE_BINANCE_HEADERS_JSON=
# CRYPTO_PULSE_BITGET_INSIGHTS_URL=https://www.bitget.com/zh-CN/insights
# CRYPTO_PULSE_BITGET_SQUARE_URL=
# CRYPTO_PULSE_OKX_SQUARE_URL=

# HTTP/bapi 失败时：CDP 连本机 Chrome 打开对应平台页（默认开）
# CRYPTO_PULSE_CDP_FALLBACK=1
# CHROME_DEBUG_PORT=9222
# CRYPTO_PULSE_CDP_WAIT_SEC=4
# 前置：Chrome --remote-debugging-port=9222（建议已登录币安/Bitget/OKX）

# Reddit（PullPush）
# CRYPTO_PULSE_REDDIT_SUBREDDIT=CryptoCurrency

# TradingView Ideas
# CRYPTO_PULSE_TV_IDEAS_URL=https://www.tradingview.com/markets/cryptocurrencies/ideas/

# CryptoPanic 免费 token：https://cryptopanic.com/developers/api/
# CRYPTO_PULSE_CRYPTOPANIC_TOKEN=

# Farcaster Hub
# CRYPTO_PULSE_FARCASTER_HUB=https://hub.pinata.cloud

# 宏观日历（北京时间 ±3 天）
CRYPTO_PULSE_MACRO_MIN_STAR=3
CRYPTO_PULSE_MACRO_AHEAD_HOURS=72
CRYPTO_PULSE_MACRO_BEHIND_HOURS=72

# AI（可选）
CRYPTO_PULSE_AI_ENABLED=0

# Web
CRYPTO_PULSE_HOST=127.0.0.1
CRYPTO_PULSE_PORT=8770

# 影响力门槛
CRYPTO_PULSE_SQUARE_MIN_LIKES=200
CRYPTO_PULSE_SQUARE_MIN_COMMENTS=30
CRYPTO_PULSE_SQUARE_INFLUENTIAL_ONLY=1
CRYPTO_PULSE_TV_MIN_AGREES=30
CRYPTO_PULSE_TV_MIN_COMMENTS=10

# 代理
# HTTPS_PROXY=http://127.0.0.1:7890

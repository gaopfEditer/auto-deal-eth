//@version=6
indicator("布林带插针标记 - 多时间框架", shorttitle="BB-Wicks", overlay=true, max_bars_back=500)

// ==================== 输入参数 ====================
// 布林带参数
bb_length = input.int(20, title="布林带周期", minval=1)
bb_mult = input.float(2.0, title="布林带倍数", minval=0.1, step=0.1)
// 上下轨之间为 0%～100%（自下而上）：仅当 K 线进入上轨侧/下轨侧对应带状区才显示布林插针标签与插针类告警
bb_wick_upper_zone_pct = input.float(80.0, title="上轨侧插针: 高点≥带间(%)", minval=50.0, maxval=100.0, step=1.0, tooltip="例：带间高100点，80 表示高点至少触及自下而上 80% 线（最上 20% 为「靠近上轨」）", group="布林带参数")
bb_wick_lower_zone_pct = input.float(20.0, title="下轨侧插针: 低点≤带间(%)", minval=0.0, maxval=50.0, step=1.0, tooltip="例：20 表示低点至多触及自下而上 20% 线（最下 20% 为「靠近下轨」）", group="布林带参数")
enable_bb_wick = input.bool(false, title="显示布林带插针", tooltip="开启则显示上下轨插针标签与插针告警；关闭则不显示", group="布林带参数")

// ==================== 时间框架配置（可扩展）====================
// 配置说明：
//   - timeframes_code: 存储时间框架代码（TradingView格式）
//   - timeframes_name: 存储显示名称（对应位置）
// 时间框架代码说明：
//   "15" = 15分钟, "30" = 30分钟, "60" = 1小时
//   "240" = 4小时, "1D" = 1天, "1W" = 1周
// 要添加新时间框架，在两个数组中对应位置添加即可
var timeframes_code = array.new<string>()
var timeframes_name = array.new<string>()
if barstate.isfirst
    // 默认配置：15分钟、1小时、4小时
    array.push(timeframes_code, "15")
    array.push(timeframes_name, "15M")
    array.push(timeframes_code, "60")
    array.push(timeframes_name, "1H")
    array.push(timeframes_code, "120")
    array.push(timeframes_name, "2H")
    array.push(timeframes_code, "240")
    array.push(timeframes_name, "4H")
    array.push(timeframes_code, "480")
    array.push(timeframes_name, "8H")
    // 要添加新时间框架，取消下面的注释并修改：
    array.push(timeframes_code, "30")
    array.push(timeframes_name, "30M")  // 30分钟
    array.push(timeframes_code, "1D")
    array.push(timeframes_name, "1D")   // 1天
    array.push(timeframes_code, "1W")
    array.push(timeframes_name, "1W")   // 1周

// 插针检测参数
wick_ratio = input.float(0.3, title="插针比例（实体/影线）", minval=0.1, maxval=1.0, step=0.1, tooltip="影线长度与实体长度的比例，值越小越严格")

// 显示选项
show_labels = input.bool(true, title="显示标签", group="显示设置")
show_plots = input.bool(true, title="显示布林带", group="显示设置")
label_size = input.string("tiny", title="标签大小", options=["tiny", "small", "normal", "large", "huge"], group="显示设置")

// 警报设置
enable_alert = input.bool(true, title="启用警报", tooltip="启用后可在TradingView中设置警报，通过webhook调用API", group="警报设置")
alert_on_realtime = input.bool(true, title="实时K线警报", tooltip="在当前时间框架检测到插针时触发警报", group="警报设置")
alert_on_mtf = input.bool(false, title="多时间框架警报", tooltip="在其他时间框架检测到插针时触发警报", group="警报设置")

// RSI 预警设置
enable_rsi_alert = input.bool(true, title="启用RSI预警", tooltip="启用RSI超买超卖预警", group="RSI预警设置")
rsi_length = input.int(14, title="RSI周期", minval=1, group="RSI预警设置")
rsi_overbought = input.int(70, title="超买阈值", minval=50, maxval=100, group="RSI预警设置")
rsi_oversold = input.int(30, title="超卖阈值", minval=0, maxval=50, group="RSI预警设置")

// RSI 背离设置
enable_rsi_divergence = input.bool(true, title="启用RSI背离预警", tooltip="检测价格创新低但RSI未创新低的看涨背离", group="RSI背离设置")
divergence_lookback = input.int(9, title="历史K线周期", minval=5, maxval=50, tooltip="用于计算平均K线长度的历史周期", group="RSI背离设置")

// 连续插针检测设置
enable_continuous_wick = input.bool(true, title="启用连续插针预警", tooltip="检测上下轨附近连续插针信号", group="连续插针设置")
continuous_wick_count = input.int(2, title="插针数量", minval=2, maxval=5, tooltip="触发信号所需的连续插针数量", group="连续插针设置")

// 自定义三角形向上突破（收敛 + 吞没窗口内最低K线）
enable_custom_triangle = input.bool(true, title="启用自定义三角突破", tooltip="回看若干根已收盘K线：高逐步走低、低逐步走高、波幅收敛；当前阳线整根吞没其中最低价所在K线", group="自定义三角突破")
tri_window = input.int(12, title="回看K线数", minval=8, maxval=15, tooltip="仅统计当前K线之前的 W 根（不含当前）", group="自定义三角突破")
tri_conv_ratio = input.float(0.92, title="收敛:右侧波幅≤左侧×", minval=0.5, maxval=0.99, step=0.01, tooltip="右侧半窗最高价-最低价 ≤ 左侧×该系数，表示收敛变窄", group="自定义三角突破")

// K线形态设置（射击之星、吞没）
enable_candle_pattern = input.bool(true, title="启用K线形态预警", tooltip="检测射击之星和吞没形态", group="K线形态设置")
enable_shooting_star = input.bool(true, title="射击之星", tooltip="上影线为实体1.5～10倍；下影线无或不足上影线1/2。下轨附近须收阴，其余位置阴阳皆可", group="K线形态设置")
enable_engulfing = input.bool(true, title="吞没形态", tooltip="当前K线实体完全包住前一根K线实体", group="K线形态设置")
pattern_upper_wick_ratio = input.float(1.5, title="射击之星上影线/实体比(下限)", minval=1.5, maxval=5.0, step=0.1, tooltip="上影线须≥实体的该倍数（默认1.5）", group="K线形态设置")
pattern_upper_wick_max_ratio = input.float(20.0, title="射击之星上影线/实体比(上限)", minval=3.0, maxval=30.0, step=0.5, tooltip="上影线/实体超过该倍数时不标记（默认10；过滤极端插针，如实体极小时比例失真）", group="K线形态设置")
shooting_star_repeat_bars = input.int(5, title="射击之星(2)窗口(K线数)", minval=2, maxval=50, tooltip="第一次射击之星出现后，其后 N 根K线内再次出现，记作射击之星(2)（默认5）", group="K线形态设置")

// 维加斯通道：仅用于判断是否给信号名加「V」前缀（不画线、不改变触发逻辑）
enable_vegas_v_prefix = input.bool(true, title="仅在维加斯附近加 V 前缀", tooltip="关闭则所有信号名均不加 V", group="维加斯(V前缀)")
vegas_v_filter = input.int(12, title="过滤线周期(不参与V判定)", minval=1, tooltip="维加斯过滤线；V 前缀仅看 A/B 组四条通道线，与过滤线距离无关", group="维加斯(V前缀)")
vegas_v_a1 = input.int(144, title="A组1周期", minval=1, group="维加斯(V前缀)")
vegas_v_a2 = input.int(169, title="A组2周期", minval=1, group="维加斯(V前缀)")
vegas_v_b1 = input.int(576, title="B组1周期", minval=1, group="维加斯(V前缀)")
vegas_v_b2 = input.int(676, title="B组2周期", minval=1, group="维加斯(V前缀)")
vegas_v_tol_bb_pct = input.float(20.0, title="附近容差(占布林带宽%)", minval=1.0, maxval=60.0, step=1.0, tooltip="以布林上下轨间距类比为100：默认20表示 K 线高/低/收与任一维加斯EMA的最小距离 ≤ 带宽×20% 时视为在维加斯通道附近，才加 V", group="维加斯(V前缀)")

// OI 异动（巨量 + 当前|ΔOI|柱 > 前N根剔除较高值后均值的倍数）— 信号标签后缀
enable_oi_anomaly = input.bool(true, title="启用OI异动标注", tooltip="成交量巨量，且当前|ΔOI|柱 > 前N根（剔除较高值后均值）×倍数时，追加 (oi异动)/(oi清算)/(oi建仓)", group="OI异动")
oi_symbol_override = input.string("", title="OI品种(空=自动 ticker+_OI)", tooltip="例 BINANCE:BTCUSDT.P_OI；留空则用当前品种拼 _OI（现货图会尝试 .P_OI）", group="OI异动")
oi_lookback = input.int(20, title="OI柱对比窗口", minval=10, maxval=100, group="OI异动", tooltip="对比前边多少根 |ΔOI| 柱")
oi_trim_high_n = input.int(4, title="剔除较高值根数", minval=0, maxval=20, group="OI异动", tooltip="从前N根|ΔOI|中去掉最大的若干根后再算均值，避免极端高柱抬高基准")
oi_bar_mult = input.float(2.0, title="OI柱倍数阈值", minval=1.0, maxval=10.0, step=0.1, tooltip="当前|ΔOI| > 剔除高值后均值 × 该倍数", group="OI异动")
oi_vol_mult = input.float(1.1, title="巨量: 相对SMA倍数", minval=1.0, maxval=5.0, step=0.1, tooltip="volume > SMA(volume,N) × 该倍数；越低越灵敏", group="OI异动")
oi_vol_z = input.float(0.8, title="巨量: 额外Z阈值", minval=0.0, maxval=5.0, step=0.1, tooltip="同时要求 volume > SMA + Z×StDev；设 0 则仅用倍数条件；越低越灵敏", group="OI异动")
oi_tag_mode = input.string("统一(oi异动)", title="标签后缀样式", options=["统一(oi异动)", "细分(oi清算/oi建仓)"], group="OI异动")
show_oi_bg = input.bool(false, title="异动K线背景着色", tooltip="巨量+OI剧降=橙底；巨量+OI暴增=蓝底（仅调试）", group="OI异动")

// 定时日线推送设置
enable_daily_line_push = input.bool(true, title="启用定时日线推送", tooltip="按设定时间推送指定交易对的日线数据", group="定时日线推送")
daily_push_symbol = input.symbol("BINANCE:BTCUSDT", title="推送交易对", group="定时日线推送")
daily_push_hour = input.int(8, title="推送小时（北京时间）", minval=0, maxval=23, group="定时日线推送")
daily_push_minute = input.int(1, title="推送分钟（北京时间）", minval=0, maxval=59, group="定时日线推送")

// 颜色设置
color_upper_wick = input.color(color.new(color.red, 0), title="上插针颜色", group="颜色设置")
color_lower_wick = input.color(color.new(color.green, 0), title="下插针颜色", group="颜色设置")

// ==================== 函数：计算布林带 ====================
calc_bb(tf) =>
    [high_tf, low_tf, close_tf, open_tf] = request.security(syminfo.tickerid, tf, [high, low, close, open], lookahead=barmerge.lookahead_off)
    // 计算布林带
    basis = ta.sma(close_tf, bb_length)
    dev = bb_mult * ta.stdev(close_tf, bb_length)
    upper = basis + dev
    lower = basis - dev
    [upper, lower, basis, high_tf, low_tf, close_tf, open_tf]

// ==================== 函数：检测插针 ====================
detect_wick(upper_band, lower_band, high_price, low_price, open_price, close_price) =>
    body_size = math.abs(close_price - open_price)
    upper_wick = high_price - math.max(open_price, close_price)
    lower_wick = math.min(open_price, close_price) - low_price
    // 上插针：上影线突破上轨，且上影线长度满足条件
    upper_wick_condition = high_price > upper_band and upper_wick > 0 and (body_size == 0 or upper_wick / math.max(body_size, 0.0001) >= wick_ratio)
    // 下插针：下影线突破下轨，且下影线长度满足条件
    lower_wick_condition = low_price < lower_band and lower_wick > 0 and (body_size == 0 or lower_wick / math.max(body_size, 0.0001) >= wick_ratio)
    [upper_wick_condition, lower_wick_condition, upper_wick, lower_wick]

// 布林插针是否同时落在「靠近上下轨」的带间位置（用于显示/插针告警，不改变 detect_wick 本体）
// 上轨侧：高点至少触及自下而上 upper_pct% 线（与突破上轨的 detect_wick 可同时成立）；下轨侧：低点至多触及自下而上 lower_pct% 线（含刺破下轨）
bb_wick_rng(upper_band, lower_band) =>
    upper_band - lower_band

bb_wick_show_upper(upper_wick_raw, high_price, lower_band, upper_band) =>
    rng = bb_wick_rng(upper_band, lower_band)
    lo_line = lower_band + rng * bb_wick_upper_zone_pct / 100.0
    upper_wick_raw and (rng <= syminfo.mintick ? upper_wick_raw : high_price >= lo_line)

bb_wick_show_lower(lower_wick_raw, low_price, lower_band, upper_band) =>
    rng = bb_wick_rng(upper_band, lower_band)
    hi_line = lower_band + rng * bb_wick_lower_zone_pct / 100.0
    lower_wick_raw and (rng <= syminfo.mintick ? lower_wick_raw : low_price <= hi_line)

// K 线高/低/收到 A/B 组四条维加斯通道线的最近距离（不含过滤线）
min_dist_to_vegas_channel_emas(h, l, c, e2, e3, e4, e5) =>
    m2 = math.min(math.min(math.abs(h - e2), math.abs(l - e2)), math.abs(c - e2))
    m3 = math.min(math.min(math.abs(h - e3), math.abs(l - e3)), math.abs(c - e3))
    m4 = math.min(math.min(math.abs(h - e4), math.abs(l - e4)), math.abs(c - e4))
    m5 = math.min(math.min(math.abs(h - e5), math.abs(l - e5)), math.abs(c - e5))
    math.min(math.min(m2, m3), math.min(m4, m5))

// 自定义三角：回看 [1..W] 已收盘K线，左半更旧、右半更新；高均走低、低均走高、右半波幅收窄；当前阳线整根吞没窗口内最低价K线
custom_triangle_breakout_ok(W, half, conv_ratio) =>
    ok = false
    if enable_custom_triangle and bar_index > W + 2 and half >= 1 and W > half
        sum_hi_L = 0.0
        sum_hi_R = 0.0
        sum_lo_L = 0.0
        sum_lo_R = 0.0
        cnt_L = 0
        cnt_R = 0
        for j = half + 1 to W
            sum_hi_L += high[j]
            sum_lo_L += low[j]
            cnt_L += 1
        for j = 1 to half
            sum_hi_R += high[j]
            sum_lo_R += low[j]
            cnt_R += 1
        avg_hi_L = cnt_L > 0 ? sum_hi_L / cnt_L : na
        avg_hi_R = cnt_R > 0 ? sum_hi_R / cnt_R : na
        avg_lo_L = cnt_L > 0 ? sum_lo_L / cnt_L : na
        avg_lo_R = cnt_R > 0 ? sum_lo_R / cnt_R : na
        hi_desc = not na(avg_hi_L) and not na(avg_hi_R) and avg_hi_L > avg_hi_R
        lo_asc = not na(avg_lo_L) and not na(avg_lo_R) and avg_lo_R > avg_lo_L
        hi_L = -1.0e20
        lo_L = 1.0e20
        for j = half + 1 to W
            hi_L := math.max(hi_L, high[j])
            lo_L := math.min(lo_L, low[j])
        hi_R = -1.0e20
        lo_R = 1.0e20
        for j = 1 to half
            hi_R := math.max(hi_R, high[j])
            lo_R := math.min(lo_R, low[j])
        range_L = hi_L - lo_L
        range_R = hi_R - lo_R
        conv = range_L > syminfo.mintick * 2 and range_R <= range_L * conv_ratio
        min_l = low[1]
        k_at = 1
        for j = 2 to W
            if low[j] < min_l
                min_l := low[j]
                k_at := j
        engulf = close > open and open <= low[k_at] and close >= high[k_at]
        ok := hi_desc and lo_asc and conv and engulf
    ok

// ==================== 函数：检测射击之星 ====================
// 射击之星：上影线 ∈ [实体×ratio, 实体×max_ratio]；下影线无或 < 上影线×1/2；at_lower 时须收阴
detect_shooting_star(h_price, l_price, o_price, c_price, ratio, max_ratio, at_lower) =>
    body = math.abs(c_price - o_price)
    upper_w = h_price - math.max(o_price, c_price)
    lower_w = math.min(o_price, c_price) - l_price
    // 上影线须为真实实体的 ratio～max_ratio 倍（默认 1.5～10；实体为 0 不算）
    upper_ok = body > syminfo.mintick and upper_w > syminfo.mintick and upper_w >= body * ratio and upper_w <= body * max_ratio
    // 下影线 < 上影线×1/2 ⇔ lower_w×2 < upper_w（与实体长短无关）
    no_lower_wick = lower_w <= syminfo.mintick
    short_lower_vs_upper = upper_w > syminfo.mintick and lower_w * 2.0 < upper_w
    shape_ok = upper_ok and (no_lower_wick or short_lower_vs_upper)
    // 下轨附近：必须收阴；其余位置不要求阴阳
    bearish_ok = not at_lower or c_price < o_price
    shape_ok and bearish_ok

// ==================== 函数：检测倒锤子（射击之星倒过来的形态）====================
// 倒锤子：下影线长、实体小，上方可有插针但上影线 < 下影线1/3，看涨 reversal 信号
detect_inverted_shooting_star(h_price, l_price, o_price, c_price, ratio) =>
    body = math.abs(c_price - o_price)
    upper_w = h_price - math.max(o_price, c_price)
    lower_w = math.min(o_price, c_price) - l_price
    // 实体不能为0，下影线>=实体*ratio，上影线 < 下影线/3（允许有上影线但须远短于下影线）
    body > 0 and lower_w >= body * ratio and upper_w < lower_w / 3

// ==================== 函数：检测吞没形态 ====================
// 看涨吞没：当前阳线实体包住前一根阴线实体
// 看跌吞没：当前阴线实体包住前一根阳线实体
detect_bullish_engulfing(o1, c1, o0, c0) =>
    prev_bearish = c1 < o1  // 前一根阴线
    curr_bullish = c0 > o0  // 当前阳线
    curr_open_below_prev_close = o0 <= c1
    curr_close_above_prev_open = c0 >= o1
    prev_bearish and curr_bullish and curr_open_below_prev_close and curr_close_above_prev_open

detect_bearish_engulfing(o1, c1, o0, c0) =>
    prev_bullish = c1 > o1  // 前一根阳线
    curr_bearish = c0 < o0  // 当前阴线
    curr_open_above_prev_close = o0 >= c1
    curr_close_below_prev_open = c0 <= o1
    prev_bullish and curr_bearish and curr_open_above_prev_close and curr_close_below_prev_open

// ==================== 辅助函数：获取标签大小 ====================
get_label_size() =>
    switch label_size
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large
        "huge" => size.huge
        => size.small

// 配置的周期是否与当前图表周期一致（用秒数比较，避免 1D / D 等字符串差异）
is_same_timeframe_as_chart(tf_code) =>
    chart_sec = timeframe.in_seconds(timeframe.period)
    tf_sec = timeframe.in_seconds(tf_code)
    not na(chart_sec) and not na(tf_sec) and chart_sec == tf_sec

// ==================== 变量：警报条件（合并后）====================
wick_alert = false  // 合并的上插针和下插针警报
rsi_alert = false  // 合并的RSI超买超卖警报
rsi_divergence_alert = false  // 合并的RSI背离警报
continuous_wick_alert = false  // 连续插针警报
candle_pattern_alert = false  // K线形态警报（射击之星、吞没）
custom_triangle_alert = false  // 自定义三角形向上突破

// 警报消息
wick_alert_message = ""
rsi_alert_message = ""
rsi_divergence_alert_message = ""
continuous_wick_alert_message = ""
candle_pattern_alert_message = ""
custom_triangle_message = ""

// 连续插针计数（用于检测连续插针信号）
var int continuous_upper_wick_counter = 0  // 连续上插针计数（上下轨附近）
var int continuous_lower_wick_counter = 0  // 连续下插针计数（上下轨附近）
// 非上下轨附近连续插针检测（用于存储历史插针位置，允许跳过最多2根K线）
var array<int> non_zone_upper_wick_bars = array.new<int>()  // 非上轨附近的上插针K线索引
var array<int> non_zone_lower_wick_bars = array.new<int>()  // 非下轨附近的下插针K线索引
var int last_shoot_star_bar = na  // 上一根射击之星 bar_index（用于判定射击之星(2)）

// ==================== 主逻辑 ====================
label_size_value = get_label_size()

// 初始化警报变量
wick_alert := false
wick_alert_message := ""

// 当前图表布林带（须在 MTF 循环之前计算，便于与图表 K 线严格同源，避免 security 对齐导致上下轨插针错位）
basis_current = ta.sma(close, bb_length)
dev_current = bb_mult * ta.stdev(close, bb_length)
upper_current = basis_current + dev_current
lower_current = basis_current - dev_current
// 下轨附近（带间自下而上 15% 以内，与吞没 at_lower_band 一致）
mid_to_lower_bb = basis_current - lower_current
lower_zone_bb = lower_current + mid_to_lower_bb * 0.15
at_lower_band = low <= lower_zone_bb

// 维加斯 A/B 组 EMA（仅这四条参与 V 前缀「附近」判定；过滤线不参与）
vegas_v_e2 = ta.ema(close, vegas_v_a1)
vegas_v_e3 = ta.ema(close, vegas_v_a2)
vegas_v_e4 = ta.ema(close, vegas_v_b1)
vegas_v_e5 = ta.ema(close, vegas_v_b2)
bb_width_for_vegas = upper_current - lower_current
vegas_min_dist = min_dist_to_vegas_channel_emas(high, low, close, vegas_v_e2, vegas_v_e3, vegas_v_e4, vegas_v_e5)
vegas_tol_abs = bb_width_for_vegas * vegas_v_tol_bb_pct / 100.0
near_vegas_channel = enable_vegas_v_prefix and bb_width_for_vegas > syminfo.mintick * 2 and vegas_min_dist <= vegas_tol_abs

// ==================== OI 异动：巨量 + 当前|ΔOI| > 前N根剔除较高值后均值×倍数 ====================
// 逻辑1 巨量+OI剧降 → 清算踩踏；逻辑2 巨量+OI暴增 → 强力建仓/博弈
resolve_oi_ticker() =>
    if str.length(oi_symbol_override) > 0
        oi_symbol_override
    else
        tid = syminfo.tickerid
        if str.endswith(tid, "_OI")
            tid
        else if str.endswith(tid, ".P")
            tid + "_OI"
        else
            // 现货图尝试永续 OI：BINANCE:BTCUSDT → BINANCE:BTCUSDT.P_OI
            tid + ".P_OI"

// 前 len 根 |src|：去掉最大的 trim_high 根后求均值（剔除较高值）
oi_trimmed_mean_prev_abs(src, len, trim_high) =>
    arr = array.new_float()
    for i = 1 to len
        v = math.abs(src[i])
        if not na(v)
            array.push(arr, v)
    n = array.size(arr)
    result = float(na)
    if n >= 3
        array.sort(arr, order.ascending)
        trim_n = math.min(trim_high, n - 1)
        keep = n - trim_n
        if keep >= 1
            sum = 0.0
            for j = 0 to keep - 1
                sum += array.get(arr, j)
            result := sum / keep
    result

oi_ticker = resolve_oi_ticker()
oi_close = request.security(oi_ticker, timeframe.period, close, ignore_invalid_symbol=true, gaps=barmerge.gaps_off)
oi_valid = not na(oi_close) and oi_close > 0
delta_oi = oi_valid ? oi_close - oi_close[1] : na
oi_abs_bar = oi_valid ? math.abs(delta_oi) : na
oi_base_mean = oi_trimmed_mean_prev_abs(delta_oi, oi_lookback, oi_trim_high_n)
// 当前 OI 柱体(|ΔOI|) > 前20根剔除较高值后均值 × 2
oi_bar_huge = oi_valid and not na(oi_abs_bar) and not na(oi_base_mean) and oi_base_mean > 0 and oi_abs_bar > oi_bar_mult * oi_base_mean
vol_sma_oi = ta.sma(volume, oi_lookback)
vol_std_oi = ta.stdev(volume, oi_lookback)
vol_huge_mult = volume > vol_sma_oi * oi_vol_mult
vol_huge_z = oi_vol_z <= 0 or volume > vol_sma_oi + oi_vol_z * vol_std_oi
vol_huge = enable_oi_anomaly and vol_huge_mult and vol_huge_z and vol_sma_oi > 0
oi_surge = oi_bar_huge and delta_oi > 0
oi_drop = oi_bar_huge and delta_oi < 0
oi_liquidation = vol_huge and oi_drop      // 巨量 + OI剧降 → 强制清算
oi_building = vol_huge and oi_surge        // 巨量 + OI暴增 → 强力建仓
oi_anomaly_active = oi_liquidation or oi_building
oi_tag_text = not oi_anomaly_active ? "" : oi_tag_mode == "细分(oi清算/oi建仓)" ? (oi_liquidation ? "(oi清算)" : "(oi建仓)") : "(oi异动)"

bgcolor(show_oi_bg and oi_liquidation ? color.new(color.orange, 85) : show_oi_bg and oi_building ? color.new(color.blue, 88) : na, title="OI异动背景")

// 标签/告警：维加斯附近加 V；OI 异动时追加 (oi异动) 等，例：V射击之星(oi异动)
sig_prefix(s) =>
    base = near_vegas_channel ? "V" + s : s
    oi_tag_text != "" ? base + oi_tag_text : base

// 是否为射击之星类信号名（含 V 前缀、oi 后缀与 (2)）
is_shoot_star_signal(msg) =>
    str.contains(msg, "射击之星")

// 射击之星：形态 + 下轨收阴（low 在带间下 15% 内则须 close<open）
shoot_star_shape = detect_shooting_star(high, low, open, close, pattern_upper_wick_ratio, pattern_upper_wick_max_ratio, at_lower_band)
shoot_bar = enable_candle_pattern and enable_shooting_star and shoot_star_shape
shoot_star_is_second = shoot_bar and not na(last_shoot_star_bar) and bar_index > last_shoot_star_bar and bar_index - last_shoot_star_bar <= shooting_star_repeat_bars
shoot_star_sig_name = shoot_bar ? (shoot_star_is_second ? sig_prefix("射击之星（2）") : sig_prefix("射击之星")) : ""
if shoot_bar
    last_shoot_star_bar := bar_index

// 多周期插针循环移至脚本后部（连续插针/RSI/背离/三角/K 线之后），以便与 shoot_bar 及其它告警同根判定一致

// ==================== RSI 计算和预警（合并）====================
rsi_value = ta.rsi(close, rsi_length)

// 初始化RSI警报
rsi_alert := false
rsi_alert_message := ""

// 检测 RSI 超买超卖条件（合并）
if enable_rsi_alert
    rsi_overbought_trigger = rsi_value > rsi_overbought and rsi_value[1] <= rsi_overbought
    rsi_oversold_trigger = rsi_value < rsi_oversold and rsi_value[1] >= rsi_oversold
    
    if rsi_overbought_trigger
        rsi_alert := true
        rsi_alert_message := sig_prefix("RSI超买:" + str.tostring(rsi_value, "#.##"))
    else if rsi_oversold_trigger
        rsi_alert := true
        rsi_alert_message := sig_prefix("RSI超卖:" + str.tostring(rsi_value, "#.##"))

// ==================== RSI 背离检测（实时，合并）====================
// 初始化背离警报
rsi_divergence_alert := false
rsi_divergence_alert_message := ""

if enable_rsi_divergence and not na(rsi_value)
    // 计算历史9根K线的平均长度（实体长度：|close - open|）
    avg_candle_length = 0.0
    for i = 1 to divergence_lookback
        candle_length = math.abs(close[i] - open[i])
        avg_candle_length := avg_candle_length + candle_length
    avg_candle_length := avg_candle_length / divergence_lookback
    
    // 当前K线的长度
    current_candle_length = math.abs(close - open)
    
    // 价格变化阈值：平均长度的一半
    price_threshold = avg_candle_length / 2.0
    
    // 查找左侧历史最低价和对应的RSI（不包括当前K线）
    min_distance = 3  // 至少相隔3根K线
    lowest_price = ta.lowest(low[1], divergence_lookback)
    lowest_price_idx = ta.lowestbars(low[1], divergence_lookback)
    actual_lowest_bar = 1 + math.abs(lowest_price_idx)
    lowest_rsi = (lowest_price_idx <= -min_distance and actual_lowest_bar <= divergence_lookback) ? rsi_value[actual_lowest_bar] : na
    
    // 实时检测看涨背离：价格创新低但RSI未创新低
    if not na(lowest_price) and not na(lowest_rsi)
        price_new_low = low < lowest_price
        rsi_not_new_low = rsi_value > lowest_rsi
        
        // 条件：价格创新低 + RSI未创新低 + 当前K线长度 > 平均长度的一半 + 至少相隔3根K线
        if price_new_low and rsi_not_new_low and current_candle_length > price_threshold
            rsi_divergence_alert := true
            rsi_divergence_alert_message := sig_prefix("看涨背离")
            if show_labels and not (shoot_bar and rsi_divergence_alert)
                label.new(bar_index, low, sig_prefix("看涨背离"), color=color.new(color.aqua, 0), textcolor=color.white, style=label.style_label_up, size=label_size_value)

// ==================== 绘制布林带（当前时间框架） ====================
plot(show_plots ? upper_current : na, "上轨", color=color.new(color.blue, 50), linewidth=1)
plot(show_plots ? lower_current : na, "下轨", color=color.new(color.blue, 50), linewidth=1)
plot(show_plots ? basis_current : na, "中轨", color=color.new(color.blue, 70), linewidth=1)

// ==================== 连续插针检测（上下轨附近）====================
// 初始化连续插针警报
continuous_wick_alert := false
continuous_wick_alert_message := ""

if enable_continuous_wick
    // 使用当前时间框架的数据
    body_size = math.abs(close - open)
    
    // 检测当前K线是否有插针（使用detect_wick函数）
    [upper_wick_current, lower_wick_current, uw_size_current, lw_size_current] = detect_wick(upper_current, lower_current, high, low, open, close)
    
    // ========== 上轨附近连续插针检测 ==========
    // 计算中轨到上轨的距离
    mid_to_upper = upper_current - basis_current
    // 85%位置：中轨 + 85% * (上轨 - 中轨)
    upper_zone_threshold = basis_current + mid_to_upper * 0.85
    
    // 检查当前K线是否在上轨附近（85%以上）
    is_in_upper_zone = high >= upper_zone_threshold
    
    // 计算上影线大小
    upper_wick_size = high - math.max(open, close)
    
    // 检测有效上插针：在上轨附近且插针大于实体
    valid_upper_wick = is_in_upper_zone and upper_wick_size > body_size and upper_wick_size > 0
    
    // 连续上插针计数逻辑（上下轨附近：2次即可报警）
    if valid_upper_wick
        // 检测到有效上插针，增加计数
        continuous_upper_wick_counter := continuous_upper_wick_counter + 1
        
        // 如果达到指定数量，触发信号
        if continuous_upper_wick_counter == continuous_wick_count
            continuous_wick_alert := true
            if continuous_wick_alert_message == ""
                continuous_wick_alert_message := sig_prefix("连续上插针(" + str.tostring(continuous_upper_wick_counter) + "次)")
            else
                continuous_wick_alert_message := continuous_wick_alert_message + "," + sig_prefix("连续上插针(" + str.tostring(continuous_upper_wick_counter) + "次)")
            if show_labels and not (shoot_bar and continuous_wick_alert)
                label.new(bar_index, high, sig_prefix("连续上插针"), color=color.new(color.purple, 0), textcolor=color.white, style=label.style_label_down, size=label_size_value)
    else
        // 没有检测到上插针，清空计数
        continuous_upper_wick_counter := 0
    
    // ========== 非上轨附近连续插针检测（允许跳过最多2根K线，需要3根以上插针）==========
    // 检测非上轨附近的上插针：突破上轨但不在85%区域
    non_zone_upper_wick = upper_wick_current and not is_in_upper_zone
    if non_zone_upper_wick
        // 记录当前K线索引
        array.push(non_zone_upper_wick_bars, bar_index)
        // 只保留最近20根K线的记录（避免数组过大）
        if array.size(non_zone_upper_wick_bars) > 20
            array.shift(non_zone_upper_wick_bars)
        
        // 检查是否有连续插针（允许跳过最多2根K线，需要至少3根插针）
        if array.size(non_zone_upper_wick_bars) >= 3
            // 从最新的插针开始向前检查
            recent_count = 1  // 当前K线已经有插针
            last_wick_bar = bar_index
            gap_allowed = 2  // 允许跳过的K线数量
            
            // 检查最近的插针序列（从倒数第二个开始向前检查）
            for i = array.size(non_zone_upper_wick_bars) - 2 to 0
                wick_bar = array.get(non_zone_upper_wick_bars, i)
                // 检查与前一个插针的间隔
                gap = last_wick_bar - wick_bar - 1
                if gap <= gap_allowed
                    recent_count := recent_count + 1
                    last_wick_bar := wick_bar
                else
                    // 间隔太大，停止检查
                    break
            
            // 如果找到至少3根连续插针（允许跳过最多2根K线），触发信号
            if recent_count >= 3
                continuous_wick_alert := true
                if continuous_wick_alert_message == ""
                    continuous_wick_alert_message := sig_prefix("非上轨连续上插针(" + str.tostring(recent_count) + "次)")
                else
                    continuous_wick_alert_message := continuous_wick_alert_message + "," + sig_prefix("非上轨连续上插针(" + str.tostring(recent_count) + "次)")
                if show_labels and not (shoot_bar and continuous_wick_alert)
                    label.new(bar_index, high, sig_prefix("非上轨连续上插针"), color=color.new(color.purple, 0), textcolor=color.white, style=label.style_label_down, size=label_size_value)
    
    // ========== 下轨附近连续插针检测 ==========
    // 计算中轨到下轨的距离
    mid_to_lower = basis_current - lower_current
    // 15%位置：下轨 + 15% * (中轨 - 下轨) = 下轨 + 0.15 * (中轨 - 下轨)
    lower_zone_threshold = lower_current + mid_to_lower * 0.15
    
    // 检查当前K线是否在下轨附近（15%以内）
    is_in_lower_zone = low <= lower_zone_threshold
    
    // 计算下影线大小
    lower_wick_size = math.min(open, close) - low
    
    // 检测有效下插针：在下轨附近且插针大于实体
    valid_lower_wick = is_in_lower_zone and lower_wick_size > body_size and lower_wick_size > 0
    
    // 连续下插针计数逻辑（上下轨附近：2次即可报警）
    if valid_lower_wick
        // 检测到有效下插针，增加计数
        continuous_lower_wick_counter := continuous_lower_wick_counter + 1
        
        // 如果达到指定数量，触发信号
        if continuous_lower_wick_counter == continuous_wick_count
            continuous_wick_alert := true
            if continuous_wick_alert_message == ""
                continuous_wick_alert_message := sig_prefix("连续下插针(" + str.tostring(continuous_lower_wick_counter) + "次)")
            else
                continuous_wick_alert_message := continuous_wick_alert_message + "," + sig_prefix("连续下插针(" + str.tostring(continuous_lower_wick_counter) + "次)")
            if show_labels and not (shoot_bar and continuous_wick_alert)
                label.new(bar_index, low, sig_prefix("连续下插针"), color=color.new(color.purple, 0), textcolor=color.white, style=label.style_label_up, size=label_size_value)
    else
        // 没有检测到下插针，清空计数
        continuous_lower_wick_counter := 0
    
    // ========== 非下轨附近连续插针检测（允许跳过最多2根K线，需要3根以上插针）==========
    // 检测非下轨附近的下插针：突破下轨但不在15%区域
    non_zone_lower_wick = lower_wick_current and not is_in_lower_zone
    if non_zone_lower_wick
        // 记录当前K线索引
        array.push(non_zone_lower_wick_bars, bar_index)
        // 只保留最近20根K线的记录（避免数组过大）
        if array.size(non_zone_lower_wick_bars) > 20
            array.shift(non_zone_lower_wick_bars)
        
        // 检查是否有连续插针（允许跳过最多2根K线，需要至少3根插针）
        if array.size(non_zone_lower_wick_bars) >= 3
            // 从最新的插针开始向前检查
            recent_count = 1  // 当前K线已经有插针
            last_wick_bar = bar_index
            gap_allowed = 2  // 允许跳过的K线数量
            
            // 检查最近的插针序列（从倒数第二个开始向前检查）
            for i = array.size(non_zone_lower_wick_bars) - 2 to 0
                wick_bar = array.get(non_zone_lower_wick_bars, i)
                // 检查与前一个插针的间隔
                gap = last_wick_bar - wick_bar - 1
                if gap <= gap_allowed
                    recent_count := recent_count + 1
                    last_wick_bar := wick_bar
                else
                    // 间隔太大，停止检查
                    break
            
            // 如果找到至少3根连续插针（允许跳过最多2根K线），触发信号
            if recent_count >= 3
                continuous_wick_alert := true
                if continuous_wick_alert_message == ""
                    continuous_wick_alert_message := sig_prefix("非下轨连续下插针(" + str.tostring(recent_count) + "次)")
                else
                    continuous_wick_alert_message := continuous_wick_alert_message + "," + sig_prefix("非下轨连续下插针(" + str.tostring(recent_count) + "次)")
                if show_labels and not (shoot_bar and continuous_wick_alert)
                    label.new(bar_index, low, sig_prefix("非下轨连续下插针"), color=color.new(color.purple, 0), textcolor=color.white, style=label.style_label_up, size=label_size_value)

// ==================== 自定义三角形向上突破（须在 K 线形态之前，供同根射击之星时抑制三角标签）====================
// 窗口：当前K线为信号K；之前 W 根为 [1..W]（已收盘）。左半窗更「旧」，右半窗更「新」。
custom_triangle_alert := false
custom_triangle_message := ""
W_tri = tri_window
half_tri = int(W_tri / 2)
is_custom_triangle_breakout = barstate.isconfirmed and custom_triangle_breakout_ok(W_tri, half_tri, tri_conv_ratio)

if is_custom_triangle_breakout
    custom_triangle_alert := true
    custom_triangle_message := sig_prefix("三角突破(吞没最低K)")
    if show_labels and not shoot_bar
        label.new(bar_index, low, sig_prefix("三角突破"), color=color.new(color.teal, 0), textcolor=color.white, style=label.style_label_up, size=label_size_value)

plotshape(enable_custom_triangle and is_custom_triangle_breakout and not shoot_bar, title="自定义三角突破", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)

// ==================== K线形态检测（射击之星、吞没；吞没仍须在布林上下轨附近）====================
candle_pattern_alert := false
candle_pattern_alert_message := ""

if enable_candle_pattern
    // 布林带位置判断：上轨附近（85%以上）；下轨 at_lower_band 已在主逻辑区计算
    mid_to_upper_bb = upper_current - basis_current
    upper_zone_bb = basis_current + mid_to_upper_bb * 0.85
    at_upper_band = high >= upper_zone_bb
    above_mid_band = high >= basis_current  // 中轨之上
    below_mid_band = low <= basis_current   // 中轨之下

    // 射击之星；10根K线内再次出现记作射击之星(2)
    if shoot_bar
        candle_pattern_alert := true
        candle_pattern_alert_message := shoot_star_sig_name
        if show_labels
            label.new(bar_index, high, shoot_star_sig_name, color=color.new(color.orange, 0), textcolor=color.white, style=label.style_label_down, size=label_size_value)

    // 倒锤子：看涨信号，需在中轨之下；若已符合射击之星形态则不再标为倒锤子
    inv_shoot_star = enable_shooting_star and below_mid_band and not shoot_star_shape and detect_inverted_shooting_star(high, low, open, close, pattern_upper_wick_ratio)
    if inv_shoot_star
        candle_pattern_alert := true
        if candle_pattern_alert_message != ""
            candle_pattern_alert_message := candle_pattern_alert_message + "," + sig_prefix("倒锤子")
        else
            candle_pattern_alert_message := sig_prefix("倒锤子")
        if show_labels and not (shoot_bar and inv_shoot_star)
            label.new(bar_index, low, sig_prefix("倒锤子"), color=color.new(color.aqua, 0), textcolor=color.white, style=label.style_label_up, size=label_size_value)

    // 看涨吞没：当前阳线包住前一根阴线，需在布林带下轨附近
    bull_engulf = enable_engulfing and at_lower_band and detect_bullish_engulfing(open[1], close[1], open, close)
    if bull_engulf
        candle_pattern_alert := true
        if candle_pattern_alert_message != ""
            candle_pattern_alert_message := candle_pattern_alert_message + "," + sig_prefix("看涨吞没")
        else
            candle_pattern_alert_message := sig_prefix("看涨吞没")
        if show_labels and not (shoot_bar and bull_engulf)
            label.new(bar_index, low, sig_prefix("看涨吞没"), color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=label_size_value)

    // 看跌吞没：当前阴线包住前一根阳线，需在布林带上轨附近
    bear_engulf = enable_engulfing and at_upper_band and detect_bearish_engulfing(open[1], close[1], open, close)
    if bear_engulf
        candle_pattern_alert := true
        if candle_pattern_alert_message != ""
            candle_pattern_alert_message := candle_pattern_alert_message + "," + sig_prefix("看跌吞没")
        else
            candle_pattern_alert_message := sig_prefix("看跌吞没")
        if show_labels and not (shoot_bar and bear_engulf)
            label.new(bar_index, high, sig_prefix("看跌吞没"), color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=label_size_value)

// 多周期插针：在其它告警变量就绪后执行；同根有射击之星时，布林插针标签或其它类告警并存则优先射击之星（不画 MTF 插针标签；MTF 告警仍合并）
other_sig_vs_shoot_star = continuous_wick_alert or rsi_alert or rsi_divergence_alert or custom_triangle_alert or (candle_pattern_alert and not is_shoot_star_signal(candle_pattern_alert_message))

for i = 0 to array.size(timeframes_code) - 1
    tf_code = array.get(timeframes_code, i)
    tf_name = array.get(timeframes_name, i)
    same_tf = is_same_timeframe_as_chart(tf_code)
    [upper_tf, lower_tf, basis_tf, high_tf, low_tf, close_tf, open_tf] = calc_bb(tf_code)
    uB = same_tf ? upper_current : upper_tf
    lB = same_tf ? lower_current : lower_tf
    hPx = same_tf ? high : high_tf
    lPx = same_tf ? low : low_tf
    oPx = same_tf ? open : open_tf
    cPx = same_tf ? close : close_tf
    [upper_wick_tf, lower_wick_tf, uw_size_tf, lw_size_tf] = detect_wick(uB, lB, hPx, lPx, oPx, cPx)
    show_upper_wick_tf = enable_bb_wick and bb_wick_show_upper(upper_wick_tf, hPx, lB, uB)
    show_lower_wick_tf = enable_bb_wick and bb_wick_show_lower(lower_wick_tf, lPx, lB, uB)
    suppress_mtf_wick_label = shoot_bar and (other_sig_vs_shoot_star or show_upper_wick_tf or show_lower_wick_tf)

    if show_upper_wick_tf
        if show_labels and same_tf and not suppress_mtf_wick_label
            label.new(bar_index, hPx, sig_prefix(tf_name + "↑"), color=color_upper_wick, textcolor=color.white, style=label.style_label_down, size=label_size_value)
        if enable_alert and alert_on_mtf
            wick_alert := true
            if wick_alert_message == ""
                wick_alert_message := sig_prefix("上插针:" + tf_name + "@" + str.tostring(hPx))
            else
                wick_alert_message := wick_alert_message + "," + sig_prefix("上插针:" + tf_name + "@" + str.tostring(hPx))

    if show_lower_wick_tf
        if show_labels and same_tf and not suppress_mtf_wick_label
            label.new(bar_index, lPx, sig_prefix(tf_name + "↓"), color=color_lower_wick, textcolor=color.white, style=label.style_label_up, size=label_size_value)
        if enable_alert and alert_on_mtf
            wick_alert := true
            if wick_alert_message == ""
                wick_alert_message := sig_prefix("下插针:" + tf_name + "@" + str.tostring(lPx))
            else
                wick_alert_message := wick_alert_message + "," + sig_prefix("下插针:" + tf_name + "@" + str.tostring(lPx))

// ==================== 实时检测当前K线的插针 ====================
if barstate.islast
    // 使用当前图表的数据计算布林带
    basis_realtime = ta.sma(close, bb_length)
    dev_realtime = bb_mult * ta.stdev(close, bb_length)
    upper_realtime = basis_realtime + dev_realtime
    lower_realtime = basis_realtime - dev_realtime
    [upper_wick_realtime, lower_wick_realtime, uw_size_realtime, lw_size_realtime] = detect_wick(upper_realtime, lower_realtime, high, low, open, close)
    show_upper_rt = enable_bb_wick and bb_wick_show_upper(upper_wick_realtime, high, lower_realtime, upper_realtime)
    show_lower_rt = enable_bb_wick and bb_wick_show_lower(lower_wick_realtime, low, lower_realtime, upper_realtime)
    // 实时标记（仅在最后一根K线，且须靠近上下轨带）
    if show_upper_rt and show_labels and not shoot_bar
        label.new(bar_index, high, sig_prefix("实时↑"), color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down, size=size.normal)
    if show_lower_rt and show_labels and not shoot_bar
        label.new(bar_index, low, sig_prefix("实时↓"), color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_up, size=size.normal)
    
    // 设置实时警报（合并上插针和下插针）
    if enable_alert and alert_on_realtime
        if show_upper_rt or show_lower_rt
            wick_alert := true
            if show_upper_rt and show_lower_rt
                wick_alert_message := sig_prefix("实时上插针@" + str.tostring(high) + ",下插针@" + str.tostring(low) + " 价格:" + str.tostring(close))
            else if show_upper_rt
                wick_alert_message := sig_prefix("实时上插针@" + str.tostring(high) + " 价格:" + str.tostring(close))
            else
                wick_alert_message := sig_prefix("实时下插针@" + str.tostring(low) + " 价格:" + str.tostring(close))

// ==================== 警报：动态消息携带信号类型（合并为单一日志）====================
// 格式：ticker | 信号中文描述 | time | close | high | low ; 触发信号【周期】
// 插针：仅连续插针预警；K线形态：具体到射击之星/倒锤子/看涨吞没/看跌吞没
get_alert_time() =>
    str.format("{0,date,yyyy-MM-dd'T'HH:mm:ss'Z'}", time)

// 当前图表周期转可读标签（兜底不为空）
get_timeframe_label() =>
    tf = timeframe.period
    // 分钟周期：1/3/5/15/30/45/60/120/240...
    n = str.tonumber(tf)
    if not na(n)
        n >= 60 and n % 60 == 0 ? str.tostring(int(n / 60)) + "h" : str.tostring(int(n)) + "m"
    else
        // 非分钟周期：D/W/M 等
        tf == "D" or tf == "1D" ? "1D" :
         tf == "W" or tf == "1W" ? "1W" :
         tf == "M" or tf == "1M" ? "1M" :
         (str.length(tf) > 0 ? tf : "unknown_tf")

// 生成北京时间日期键，用于限制每天只推送一次
get_bj_day_key() =>
    y = year(time, "Asia/Shanghai")
    m = month(time, "Asia/Shanghai")
    d = dayofmonth(time, "Asia/Shanghai")
    y * 10000 + m * 100 + d

// 记录最近一次日线推送日期
var int last_daily_line_push_day = na

// 定时推送指定交易对上一根完整日线（北京时间）
if enable_daily_line_push and barstate.isconfirmed
    is_push_time = hour(time, "Asia/Shanghai") == daily_push_hour and minute(time, "Asia/Shanghai") == daily_push_minute
    day_key = get_bj_day_key()
    if is_push_time and day_key != last_daily_line_push_day
        d_open = request.security(daily_push_symbol, "1D", open[1], lookahead=barmerge.lookahead_off)
        d_high = request.security(daily_push_symbol, "1D", high[1], lookahead=barmerge.lookahead_off)
        d_low = request.security(daily_push_symbol, "1D", low[1], lookahead=barmerge.lookahead_off)
        d_close = request.security(daily_push_symbol, "1D", close[1], lookahead=barmerge.lookahead_off)
        d_time = request.security(daily_push_symbol, "1D", time[1], lookahead=barmerge.lookahead_off)
        d_time_str = str.format("{0,date,yyyy-MM-dd}", d_time)
        daily_msg = str.format("{0} | 日线播报 | {1} | O:{2} H:{3} L:{4} C:{5}; 定时推送", daily_push_symbol, d_time_str, str.tostring(d_open), str.tostring(d_high), str.tostring(d_low), str.tostring(d_close))
        alert(daily_msg, alert.freq_once_per_bar_close)
        last_daily_line_push_day := day_key

all_signals = continuous_wick_alert or rsi_alert or rsi_divergence_alert or custom_triangle_alert or candle_pattern_alert
// 同根 K 线：射击之星与其它任意合并信号并存时，推送文案固定为射击之星
shoot_star_push_priority = shoot_bar and (continuous_wick_alert or rsi_alert or rsi_divergence_alert or custom_triangle_alert or (candle_pattern_alert and not is_shoot_star_signal(candle_pattern_alert_message)))

if all_signals
    sig_desc = ""
    if shoot_star_push_priority
        sig_desc := shoot_star_sig_name
    else if continuous_wick_alert
        sig_desc := continuous_wick_alert_message != "" ? continuous_wick_alert_message : sig_prefix("连续插针")
    else if rsi_alert
        sig_desc := rsi_alert_message != "" ? rsi_alert_message : sig_prefix("RSI超买超卖")
    else if rsi_divergence_alert
        sig_desc := rsi_divergence_alert_message != "" ? rsi_divergence_alert_message : sig_prefix("RSI背离")
    else if custom_triangle_alert
        sig_desc := custom_triangle_message != "" ? custom_triangle_message : sig_prefix("三角突破")
    else if candle_pattern_alert
        sig_desc := candle_pattern_alert_message != "" ? candle_pattern_alert_message : sig_prefix("K线形态")
    else
        sig_desc := sig_prefix("未知信号")
    t_str = get_alert_time()
    tf_label = get_timeframe_label()
    // 触发信号【15m】/【1h】/【4h】等，与警报所选周期一致
    final_msg = str.format("{0} | {1} | {2} | {3} | {4} | {5} | {6}; 触发信号", syminfo.ticker, sig_desc, t_str, str.tostring(close), str.tostring(high), str.tostring(low), tf_label)
    alert(final_msg, alert.freq_once_per_bar_close)

